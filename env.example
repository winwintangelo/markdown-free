# Umami Analytics (for tracking on the website)
NEXT_PUBLIC_UMAMI_HOST=https://cloud.umami.is
NEXT_PUBLIC_UMAMI_WEBSITE_ID=<your-website-id>

# Umami API (for report generation script)
# NOTE: free Umami Cloud no longer includes API access — `npm run report` will 401.
# On-site analytics now come from the Vercel Web Analytics API (VERCEL_TOKEN below),
# read by the growth loop via `npm run report:vercel` / `npm run snapshot`.
UMAMI_API_KEY=<your-umami-api-key>
UMAMI_WEBSITE_ID=<your-website-id>
UMAMI_API_HOST=https://api.umami.is
REPORT_DAYS=30

# Bing Webmaster Tools API (for `npm run report:bing` — search query/position data)
# This is the GSC-equivalent for the Bing / cn.bing / Chinese-AI channel that
# Google Search Console can't see (our largest audience, CN, arrives via Bing).
# Get the key: https://www.bing.com/webmasters → verify site → Settings (gear)
#   → "API access" → Generate. Then paste it below.
BING_API_KEY=<your-bing-webmaster-api-key>
# Exact verified site URL as shown in Bing Webmaster Tools (try with/without
# trailing slash if you get an "invalid site" error). Default: https://www.markdown.free
BING_SITE_URL=https://www.markdown.free

# --- Growth loop collectors (docs/growth-impl.md §13) ------------------------
# Google Search Console — service account, read-only.
#  1. Google Cloud → enable "Google Search Console API" → create a service account
#     → Keys → Add key → JSON → download it (keep OUT of git).
#  2. Search Console → Settings → Users and permissions → add the service account's
#     email (Restricted / read-only). No domain-wide delegation needed.
GSC_SERVICE_ACCOUNT_KEY=/absolute/path/outside/repo/gsc-key.json
GSC_SITE_URL=sc-domain:markdown.free          # domain property; or https://www.markdown.free/

# Vercel Web Analytics (visits + custom conversion events) — replaces the dead Umami API.
# Vercel → Settings → Tokens → create (scope to the team if the project is team-owned).
VERCEL_TOKEN=<your-vercel-token>
VERCEL_PROJECT_ID=markdown-free
# VERCEL_TEAM_ID=team_xxxx                     # only if the project is team-owned

# Baidu (CN market) — manual CSV drop until the API path is worth automating.
# Export the performance CSV from 百度搜索资源平台 and point this at it.
# BAIDU_CSV=/absolute/path/to/baidu-export.csv  # default: data/drops/baidu.csv

# Demand discovery (W1) — GitHub painpoint search. Optional: unauthenticated works
# (10 req/min); a token raises it to 30/min. https://github.com/settings/tokens (no scopes needed).
# GITHUB_TOKEN=ghp_xxxx

# Security: HSTS preload directive (production only)
# Leave unset/false until the domain is registered at https://hstspreload.org
# and confirmed in the preload list. Enabling without registration commits
# browsers to HTTPS-only for ~1 year with no quick rollback.
HSTS_PRELOAD_ENABLED=false
# --- Feedback delivery (src/app/api/feedback/route.ts) -------------------------
# Feedback-form messages and post-convert comments are emailed to you through
# Resend instead of being attached to analytics events (privacy policy: no
# personal information or free text in analytics). Without these the endpoint
# still accepts messages but reports delivered:false and drops them.
RESEND_API_KEY=<your-resend-api-key>
FEEDBACK_TO_EMAIL=<inbox-that-receives-feedback>
# Optional. Must be a verified Resend domain sender; the default only delivers
# to the Resend account owner's address.
# FEEDBACK_FROM_EMAIL="Markdown Free <feedback@markdown.free>"

# --- "Notify me" signups (src/app/api/notify/route.ts) -------------------------
# The Phase 1.5 feature teaser stores opt-in email addresses in Supabase
# (table public.notify_signups, created by supabase/migrations/). The Vercel
# Supabase integration sets both variables. Server-only: never prefix the key
# with NEXT_PUBLIC_. Without them the endpoint answers {ok:true} and stores
# nothing, so the teaser still works in local development.
# Step-by-step setup: docs/supabase-setup.md
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<sb_secret_...>
# Legacy projects: the service_role JWT works in place of the secret key.
# SUPABASE_SERVICE_ROLE_KEY=<eyJ...>

# --- Testing only --------------------------------------------------------------
# Set on the `npm run start` process the e2e suite targets (never on Vercel):
# lifts the per-IP API rate budgets that the parallel suite would trip, stops
# /api/feedback from delivering (test runs must not mail the owner), and stops
# /api/notify from storing signups.
# E2E_RELAXED_RATE_LIMITS=1
